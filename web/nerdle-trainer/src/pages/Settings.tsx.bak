import { FormEvent, useState } from "react";
import { useSettings } from "../state/SettingsContext";
export default function SettingsPage(){
  const { settings, setSettings } = useSettings();
  const [apiBase,setApiBase]=useState(settings.apiBase);
  const [defaultLength,setDefaultLength]=useState(settings.defaultLength);
  const [ops,setOps]=useState(settings.ops);
  function save(e:FormEvent){ e.preventDefault(); setSettings({ apiBase: apiBase.replace(/\/+$/,""), defaultLength, ops }); }
  return (
    <form onSubmit={save} className="max-w-xl bg-neutral-900 rounded-2xl p-5 shadow-soft grid gap-4">
      <div className="text-lg font-semibold">Settings</div>
      <L label="API base URL">
        <input className="w-full bg-neutral-800 rounded-lg px-3 py-2 font-mono" value={apiBase} onChange={e=>setApiBase(e.target.value)} placeholder="http://127.0.0.1:8082" />
      </L>
      <div className="grid grid-cols-2 gap-3">
        <L label="Default length"><input type="number" min={6} max={12} className="w-full bg-neutral-800 rounded-lg px-3 py-2" value={defaultLength} onChange={e=>setDefaultLength(Number(e.target.value))} /></L>
        <L label="Operators (+-*/=)"><input className="w-full bg-neutral-800 rounded-lg px-3 py-2" value={ops} onChange={e=>setOps(e.target.value)} /></L>
      </div>
      <div className="flex gap-2">
        <button className="button">Save</button>
        <div className="text-xs text-neutral-500 self-center">Current: <span className="font-mono">{settings.apiBase}</span></div>
      </div>
    </form>
  );
}
function L({ label, children }: { label:string; children:React.ReactNode }){ return (<label className="grid gap-1"><span className="text-xs uppercase text-neutral-400">{label}</span>{children}</label>); }
