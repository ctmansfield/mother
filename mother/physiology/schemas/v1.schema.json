        "ingested_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "original_value": {
          "type": [
            "number",
            "string",
            "boolean",
            "null"
