        "value_status": {
          "enum": [
            "valid",
            "missing",
            "invalid",
            "unobserved"
          ]
        },
        "epistemic_type": {
          "enum": [
            "measured",
            "vendor_derived",
            "derived",
            "imputed",
            "inferred",
            "clinical_interpretation",
            "reported"
          ]
        },
        "method": {
          "type": [
            "string",
            "null"
          ]
        },
        "device_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "recording_app": {
          "type": [
            "string",
            "null"
          ]
        },
        "body_site": {
          "type": [
            "string",
            "null"
          ]
        },
        "specimen": {
          "type": [
            "string",
            "null"
          ]
        },
        "session_id": {
          "type": [
            "string",
            "null"
          ]
