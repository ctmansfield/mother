{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mothercoach.invalid/proposals/mse/v0.1.0/common.schema.json",
  "title": "common",
  "description": "Shared data-only definitions for proposed MSE contracts v0.1.0. No existing API is asserted.",
  "$defs": {
    "stable_id": {
      "type": "string",
      "pattern": "^urn:mse:[A-Za-z0-9][A-Za-z0-9:._-]*$"
    },
    "record_ref": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/stable_id"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "additionalProperties": false
    },
    "entity_ref": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "namespace": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "label",
        "namespace"
      ],
      "additionalProperties": false
    },
    "snapshot_ref": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/stable_id"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "canonicalization": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "sha256",
        "canonicalization"
      ],
      "additionalProperties": false
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_.-]*$"
      },
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean",
          "null"
        ]
      },
      "description": "Inert scalar metadata only. Consumers must never execute extension values."
    },
    "truth_value": {
      "enum": [
        "true",
        "false",
        "unknown"
      ]
    },
    "provenance": {
      "type": "object",
      "properties": {
        "author_or_model_id": {
          "type": "string",
          "minLength": 1
        },
        "method_version": {
          "type": "string",
          "minLength": 1
        },
        "source_record_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/record_ref"
          },
          "minItems": 0
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "author_or_model_id",
        "method_version",
        "source_record_refs",
        "notes"
      ],
      "additionalProperties": false
    },
    "uncertainty": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "quantified",
            "qualitative",
            "unknown"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "type": "array",
          "items": {
            "enum": [
              "measurement",
              "parameter",
              "model",
              "context_transport",
              "missingness",
              "causal"
            ]
          },
          "minItems": 0
        }
      },
      "required": [
        "status",
        "description",
        "sources"
      ],
      "additionalProperties": false
    },
    "interval": {
      "type": "object",
      "properties": {
        "lower": {
          "type": "number"
        },
        "upper": {
          "type": "number"
        },
        "level": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "kind": {
          "enum": [
            "confidence",
            "credible",
            "prediction",
            "bounds"
          ]
        },
        "method": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "lower",
        "upper",
        "level",
        "kind",
        "method"
      ],
      "additionalProperties": false
    },
    "quantity_estimate": {
      "type": "object",
      "properties": {
        "quantity_id": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "interval": {
          "anyOf": [
            {
              "$ref": "#/$defs/interval"
            },
            {
              "type": "null"
            }
          ]
        },
        "epistemic_status": {
          "enum": [
            "measured",
            "inferred",
            "simulated",
            "unknown"
          ]
        },
        "uncertainty": {
          "$ref": "#/$defs/uncertainty"
        }
      },
      "required": [
        "quantity_id",
        "value",
        "unit",
        "interval",
        "epistemic_status",
        "uncertainty"
      ],
      "additionalProperties": false
    },
    "delay": {
      "type": "object",
      "properties": {
        "earliest_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "latest_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "distribution": {
          "type": [
            "string",
            "null"
          ]
        },
        "basis": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "earliest_seconds",
        "latest_seconds",
        "distribution",
        "basis"
      ],
      "additionalProperties": false
    },
    "direction": {
      "enum": [
        "increase",
        "decrease",
        "no_change",
        "nonmonotonic",
        "context_dependent",
        "unknown"
      ]
    },
    "parameter": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "measured",
            "estimated",
            "assumed",
            "unknown"
          ]
        },
        "interval": {
          "anyOf": [
            {
              "$ref": "#/$defs/interval"
            },
            {
              "type": "null"
            }
          ]
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "name",
        "value",
        "unit",
        "status",
        "interval",
        "assumptions"
      ],
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "properties": {
        "species": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entity_ref"
          },
          "minItems": 0
        },
        "strains": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "tissues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entity_ref"
          },
          "minItems": 0
        },
        "cell_types": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entity_ref"
          },
          "minItems": 0
        },
        "compartments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entity_ref"
          },
          "minItems": 0
        },
        "context_description": {
          "type": "string",
          "minLength": 1
        },
        "valid_from": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "valid_until": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "scope_status": {
          "enum": [
            "specified",
            "partial",
            "unknown"
          ]
        }
      },
      "required": [
        "species",
        "strains",
        "tissues",
        "cell_types",
        "compartments",
        "context_description",
        "valid_from",
        "valid_until",
        "scope_status"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "source": {
          "type": "object",
          "properties": {
            "doi": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^10\\.[0-9]{4,9}/\\S+$"
            },
            "pmid": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9]+$"
            },
            "url": {
              "type": [
                "string",
                "null"
              ],
              "format": "uri"
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "verified_at": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            }
          },
          "required": [
            "doi",
            "pmid",
            "url",
            "title",
            "verified_at"
          ],
          "additionalProperties": false,
          "anyOf": [
            {
              "properties": {
                "doi": {
                  "type": "string"
                }
              }
            },
            {
              "properties": {
                "pmid": {
                  "type": "string"
                }
              }
            },
            {
              "properties": {
                "url": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "relationship": {
          "enum": [
            "supports",
            "contradicts",
            "qualifies"
          ]
        },
        "grade": {
          "enum": [
            "A",
            "B",
            "C",
            "D"
          ]
        },
        "grade_rationale": {
          "type": "string",
          "minLength": 1
        },
        "claim_supported_or_challenged": {
          "type": "string",
          "minLength": 1
        },
        "study_context": {
          "$ref": "#/$defs/scope"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "applicability": {
          "enum": [
            "same_scope",
            "transport_assumptions_required",
            "unknown"
          ]
        }
      },
      "required": [
        "source",
        "relationship",
        "grade",
        "grade_rationale",
        "claim_supported_or_challenged",
        "study_context",
        "limitations",
        "applicability"
      ],
      "additionalProperties": false
    },
    "predicate": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "op": {
              "enum": [
                "compare"
              ]
            },
            "variable": {
              "type": "string",
              "minLength": 1
            },
            "comparator": {
              "enum": [
                "eq",
                "ne",
                "lt",
                "le",
                "gt",
                "ge",
                "in"
              ]
            },
            "expected": {
              "type": [
                "string",
                "number",
                "boolean",
                "array"
              ]
            },
            "unit": {
              "type": [
                "string",
                "null"
              ]
            },
            "missing_result": {
              "const": "unknown"
            }
          },
          "required": [
            "op",
            "variable",
            "comparator",
            "expected",
            "unit",
            "missing_result"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "comparator": {
                    "const": "in"
                  }
                }
              },
              "then": {
                "properties": {
                  "expected": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": [
                        "string",
                        "number",
                        "boolean"
                      ]
                    }
                  }
                }
              },
              "else": {
                "properties": {
                  "expected": {
                    "type": [
                      "string",
                      "number",
                      "boolean"
                    ]
                  }
                }
              }
            }
          ]
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "enum": [
                "all_of"
              ]
            },
            "terms": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/predicate"
              },
              "minItems": 1
            }
          },
          "required": [
            "op",
            "terms"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "enum": [
                "any_of"
              ]
            },
            "terms": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/predicate"
              },
              "minItems": 1
            }
          },
          "required": [
            "op",
            "terms"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "enum": [
                "not"
              ]
            },
            "term": {
              "$ref": "#/$defs/predicate"
            }
          },
          "required": [
            "op",
            "term"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "enum": [
                "constant"
              ]
            },
            "value": {
              "$ref": "#/$defs/truth_value"
            }
          },
          "required": [
            "op",
            "value"
          ],
          "additionalProperties": false
        }
      ],
      "description": "Kleene three-valued logic. Missing variables are unknown; no closed-world false default."
    },
    "outcome_spec": {
      "type": "object",
      "properties": {
        "outcome_id": {
          "$ref": "#/$defs/stable_id"
        },
        "quantity_id": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "window": {
          "$ref": "#/$defs/delay"
        },
        "extraction_method_version": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "primary",
            "secondary",
            "adverse",
            "exploratory"
          ]
        }
      },
      "required": [
        "outcome_id",
        "quantity_id",
        "unit",
        "window",
        "extraction_method_version",
        "role"
      ],
      "additionalProperties": false
    },
    "hypothesis_prediction": {
      "type": "object",
      "properties": {
        "mechanism_ref": {
          "$ref": "#/$defs/record_ref"
        },
        "observable_quantity_id": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "$ref": "#/$defs/direction"
        },
        "prediction": {
          "$ref": "#/$defs/quantity_estimate"
        },
        "context": {
          "$ref": "#/$defs/predicate"
        },
        "discriminating_pattern": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "mechanism_ref",
        "observable_quantity_id",
        "direction",
        "prediction",
        "context",
        "discriminating_pattern"
      ],
      "additionalProperties": false
    }
  }
}
