{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MSE synthetic integration draft 0.2, revision 2 candidate",
  "oneOf": [
    {
      "$ref": "#/$defs/export"
    },
    {
      "$ref": "#/$defs/receipt"
    },
    {
      "$ref": "#/$defs/snapshot"
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
    },
    "utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "scope": {
      "type": "object",
      "properties": {
        "subject_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "source_system": {
          "const": "healthkit"
        },
        "source_instance": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "collection": {
          "const": "healtharchive"
        }
      },
      "required": [
        "subject_id",
        "source_system",
        "source_instance",
        "collection"
      ],
      "additionalProperties": false
    },
    "loss": {
      "type": "object",
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "locator": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "field",
        "reason",
        "locator"
      ],
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "properties": {
        "sha256": {
          "$ref": "#/$defs/digest"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "media_type": {
          "const": "application/json"
        },
        "source_schema": {
          "const": "healtharchive-codable-json/0.1"
        }
      },
      "required": [
        "sha256",
        "byte_length",
        "media_type",
        "source_schema"
      ],
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "properties": {
        "capture_kind": {
          "enum": [
            "full_file",
            "partial"
          ]
        },
        "backfill_start": {
          "anyOf": [
            {
              "$ref": "#/$defs/utc"
            },
            {
              "type": "null"
            }
          ]
        },
        "observed_start": {
          "anyOf": [
            {
              "$ref": "#/$defs/utc"
            },
            {
              "type": "null"
            }
          ]
        },
        "observed_end": {
          "anyOf": [
            {
              "$ref": "#/$defs/utc"
            },
            {
              "type": "null"
            }
          ]
        },
        "permissions": {
          "const": "unknown"
        },
        "completeness": {
          "const": "unknown"
        }
      },
      "required": [
        "capture_kind",
        "backfill_start",
        "observed_start",
        "observed_end",
        "permissions",
        "completeness"
      ],
      "additionalProperties": false
    },
    "observation": {
      "type": "object",
      "properties": {
        "channel": {
          "enum": [
            "heart_rate",
            "hrv_sdnn"
          ]
        },
        "original_value": {
          "type": "string",
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$"
        },
        "original_unit": {
          "enum": [
            "bpm",
            "ms"
          ]
        },
        "value": {
          "type": "string",
          "pattern": "^(?:0|-?(?:[1-9][0-9]*(?:\\.[0-9]*[1-9])?|0\\.[0-9]*[1-9]))$"
        },
        "unit": {
          "enum": [
            "bpm",
            "ms"
          ]
        },
        "original_start": {
          "type": "string",
          "minLength": 1
        },
        "original_end": {
          "type": "string",
          "minLength": 1
        },
        "original_received_at": {
          "type": "string",
          "minLength": 1
        },
        "event_start": {
          "$ref": "#/$defs/utc"
        },
        "event_end": {
          "$ref": "#/$defs/utc"
        },
        "collector_received_at": {
          "$ref": "#/$defs/utc"
        },
        "source_name": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "bundle_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "epistemic_type": {
          "enum": [
            "unknown",
            "measured",
            "vendor_derived"
          ]
        },
        "classification_basis": {
          "enum": [
            "capture_derivation_unavailable",
            "independent_measured_evidence",
            "healthkit_sdnn"
          ]
        },
        "classification_evidence_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "device_id": {
          "const": null
        },
        "calibration_id": {
          "const": null
        },
        "source_available_at": {
          "const": null
        }
      },
      "required": [
        "channel",
        "original_value",
        "original_unit",
        "value",
        "unit",
        "original_start",
        "original_end",
        "original_received_at",
        "event_start",
        "event_end",
        "collector_received_at",
        "source_name",
        "bundle_id",
        "epistemic_type",
        "classification_basis",
        "classification_evidence_sha256",
        "device_id",
        "calibration_id",
        "source_available_at"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "channel": {
              "const": "heart_rate"
            },
            "unit": {
              "const": "bpm"
            },
            "original_unit": {
              "const": "bpm"
            },
            "epistemic_type": {
              "const": "unknown"
            },
            "classification_basis": {
              "const": "capture_derivation_unavailable"
            },
            "classification_evidence_sha256": {
              "const": null
            }
          }
        },
        {
          "properties": {
            "channel": {
              "const": "heart_rate"
            },
            "unit": {
              "const": "bpm"
            },
            "original_unit": {
              "const": "bpm"
            },
            "epistemic_type": {
              "const": "measured"
            },
            "classification_basis": {
              "const": "independent_measured_evidence"
            },
            "classification_evidence_sha256": {
              "$ref": "#/$defs/digest"
            }
          }
        },
        {
          "properties": {
            "channel": {
              "const": "hrv_sdnn"
            },
            "unit": {
              "const": "ms"
            },
            "original_unit": {
              "const": "ms"
            },
            "epistemic_type": {
              "const": "vendor_derived"
            },
            "classification_basis": {
              "const": "healthkit_sdnn"
            },
            "classification_evidence_sha256": {
              "const": null
            }
          }
        }
      ]
    },
    "upsert": {
      "type": "object",
      "properties": {
        "native_id": {
          "$ref": "#/$defs/uuid"
        },
        "revision_sha256": {
          "$ref": "#/$defs/digest"
        },
        "locators": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^/"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "operation": {
          "const": "upsert"
        },
        "observation": {
          "$ref": "#/$defs/observation"
        }
      },
      "required": [
        "native_id",
        "revision_sha256",
        "locators",
        "operation",
        "observation"
      ],
      "additionalProperties": false
    },
    "delete": {
      "type": "object",
      "properties": {
        "native_id": {
          "$ref": "#/$defs/uuid"
        },
        "revision_sha256": {
          "$ref": "#/$defs/digest"
        },
        "locators": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^/"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "operation": {
          "const": "delete"
        },
        "deleted_at": {
          "$ref": "#/$defs/utc"
        },
        "original_deleted_at": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "native_id",
        "revision_sha256",
        "locators",
        "operation",
        "deleted_at",
        "original_deleted_at"
      ],
      "additionalProperties": false
    },
    "export": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "mse.healtharchive-export/0.2"
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "batch_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "capture_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "exporter_version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "artifact": {
          "$ref": "#/$defs/artifact"
        },
        "coverage": {
          "$ref": "#/$defs/coverage"
        },
        "anchor_sha256": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "Heart rate",
              "HRV (SDNN)"
            ]
          },
          "additionalProperties": {
            "$ref": "#/$defs/digest"
          }
        },
        "revisions": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/upsert"
              },
              {
                "$ref": "#/$defs/delete"
              }
            ]
          }
        },
        "losses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/loss"
          }
        }
      },
      "required": [
        "schema_version",
        "scope",
        "batch_id",
        "capture_id",
        "exporter_version",
        "artifact",
        "coverage",
        "anchor_sha256",
        "revisions",
        "losses"
      ],
      "additionalProperties": false
    },
    "receipt": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "mse.ingest-receipt/0.2"
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "archive_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "batch_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "artifact_sha256": {
          "$ref": "#/$defs/digest"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "source_schema": {
          "const": "healtharchive-codable-json/0.1"
        },
        "export_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "receipt_id": {
          "$ref": "#/$defs/digest"
        },
        "status": {
          "enum": [
            "rejected",
            "durably_received",
            "normalized",
            "quarantined"
          ]
        },
        "mother_received_at": {
          "$ref": "#/$defs/utc"
        },
        "committed_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/utc"
            },
            {
              "type": "null"
            }
          ]
        },
        "commit_sequence": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "pf001_run_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "reason_code": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "scope",
        "archive_id",
        "batch_id",
        "artifact_sha256",
        "byte_length",
        "source_schema",
        "export_sha256",
        "receipt_id",
        "status",
        "mother_received_at",
        "committed_at",
        "commit_sequence",
        "pf001_run_id",
        "reason_code"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "status": {
              "const": "rejected"
            },
            "committed_at": {
              "const": null
            },
            "commit_sequence": {
              "const": null
            },
            "pf001_run_id": {
              "const": null
            },
            "reason_code": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            }
          }
        },
        {
          "properties": {
            "status": {
              "const": "durably_received"
            },
            "committed_at": {
              "$ref": "#/$defs/utc"
            },
            "commit_sequence": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "pf001_run_id": {
              "const": null
            },
            "reason_code": {
              "const": null
            }
          }
        },
        {
          "properties": {
            "status": {
              "const": "normalized"
            },
            "export_sha256": {
              "$ref": "#/$defs/digest"
            },
            "committed_at": {
              "$ref": "#/$defs/utc"
            },
            "commit_sequence": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "pf001_run_id": {
              "type": "string",
              "minLength": 1
            },
            "reason_code": {
              "const": null
            }
          }
        },
        {
          "properties": {
            "status": {
              "const": "quarantined"
            },
            "committed_at": {
              "$ref": "#/$defs/utc"
            },
            "commit_sequence": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "pf001_run_id": {
              "const": null
            },
            "reason_code": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            }
          }
        }
      ]
    },
    "snapshot": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "mse.evidence-snapshot/0.2"
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "archive_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "purpose": {
          "const": "offline_synthetic_replay"
        },
        "measurement_start": {
          "$ref": "#/$defs/utc"
        },
        "measurement_end": {
          "$ref": "#/$defs/utc"
        },
        "knowledge_cutoff_sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "normalizer_version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "coverage": {
          "$ref": "#/$defs/coverage"
        },
        "observations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "artifact_sha256": {
                "$ref": "#/$defs/digest"
              },
              "receipt_id": {
                "$ref": "#/$defs/digest"
              },
              "commit_sequence": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "committed_at": {
                "$ref": "#/$defs/utc"
              },
              "pf001_revision_id": {
                "type": "string",
                "minLength": 1
              },
              "mother_received_at": {
                "$ref": "#/$defs/utc"
              },
              "source_revision": {
                "$ref": "#/$defs/upsert"
              },
              "processing_revision_sha256": {
                "$ref": "#/$defs/digest"
              }
            },
            "required": [
              "artifact_sha256",
              "receipt_id",
              "commit_sequence",
              "committed_at",
              "pf001_revision_id",
              "mother_received_at",
              "source_revision",
              "processing_revision_sha256"
            ],
            "additionalProperties": false
          }
        },
        "tombstones": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "artifact_sha256": {
                "$ref": "#/$defs/digest"
              },
              "receipt_id": {
                "$ref": "#/$defs/digest"
              },
              "commit_sequence": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "committed_at": {
                "$ref": "#/$defs/utc"
              },
              "pf001_revision_id": {
                "type": "string",
                "minLength": 1
              },
              "mother_received_at": {
                "$ref": "#/$defs/utc"
              },
              "source_revision": {
                "$ref": "#/$defs/delete"
              }
            },
            "required": [
              "artifact_sha256",
              "receipt_id",
              "commit_sequence",
              "committed_at",
              "pf001_revision_id",
              "mother_received_at",
              "source_revision"
            ],
            "additionalProperties": false
          }
        },
        "losses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/loss"
          }
        },
        "snapshot_sha256": {
          "$ref": "#/$defs/digest"
        }
      },
      "required": [
        "schema_version",
        "scope",
        "archive_id",
        "purpose",
        "measurement_start",
        "measurement_end",
        "knowledge_cutoff_sequence",
        "normalizer_version",
        "coverage",
        "observations",
        "tombstones",
        "losses",
        "snapshot_sha256"
      ],
      "additionalProperties": false
    }
  }
}
